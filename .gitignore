# Docker volumes and data directories
# These contain runtime data that shouldn't be version controlled
data/*
!data/.gitkeep

# MinIO configuration and data
minio/data/
minio/.minio.sys/
minio/config/*
!minio/config/.gitkeep

# PostgreSQL data directory
postgres/data/
postgres/pgdata/

# Airflow runtime files
airflow/logs/
airflow/__pycache__/
airflow/dags/__pycache__/
airflow/plugins/__pycache__/
airflow/dags/*.pyc
airflow/plugins/*.pyc

# Spark runtime directories
spark/logs/
spark/work/
spark/tmp/
spark/metastore_db/
spark/derby.log

# Spark applications compiled/generated files
spark-apps/__pycache__/
spark-apps/*.pyc
spark-apps/target/
spark-apps/build/

# Trino runtime files
trino/logs/
trino/data/
trino/var/

# Jupyter Notebook checkpoints
**/.ipynb_checkpoints/

# Environment and configuration files (if they contain secrets)
.env
.env.local
.env.production
.env.staging
kubernetes/secrets.yml

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# Log files
*.log
logs/
*.out

# Temporary files
tmp/
temp/
*.tmp
*.bak
*.backup

# Docker-related temporary files
.dockerignore.bak

# Database files (if any local SQLite, etc.)
*.db
*.sqlite
*.sqlite3

# Compressed files (if they're generated artifacts)
*.zip
*.tar.gz
*.tgz
*.tar.bz2

# Node.js dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json
yarn.lock

# Python cache (if using Python scripts)
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
