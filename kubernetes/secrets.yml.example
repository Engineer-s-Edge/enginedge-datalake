# Datalake Secrets Configuration
# IMPORTANT: This is an example file. Copy it to secrets.yml and update with your actual credentials.
# DO NOT commit secrets.yml to version control - it's in .gitignore
# 
# To use: 
#   1. Copy this file: cp secrets.yml.example secrets.yml
#   2. Update all passwords and keys with strong, unique values
#   3. Apply: kubectl apply -f secrets.yml
#
# For production, consider using:
#   - Sealed Secrets (bitnami-labs/sealed-secrets)
#   - External Secrets Operator (external-secrets/external-secrets)
#   - HashiCorp Vault
#   - Cloud provider secret managers (AWS Secrets Manager, GCP Secret Manager, Azure Key Vault)

---
# Main datalake secrets - contains all service credentials
apiVersion: v1
kind: Secret
metadata:
  name: datalake-secrets
  namespace: datalake
  labels:
    app: enginedge
    component: secrets
  annotations:
    description: "Master secret containing credentials for all datalake services"
type: Opaque
stringData:
  # MinIO Object Storage Credentials
  MINIO_ROOT_USER: minioadmin
  MINIO_ROOT_PASSWORD: minioadmin123  # CHANGE IN PRODUCTION
  MINIO_ACCESS_KEY: minioadmin
  MINIO_SECRET_KEY: minioadmin123  # CHANGE IN PRODUCTION
  
  # PostgreSQL Database Credentials
  POSTGRES_USER: airflow
  POSTGRES_PASSWORD: airflow  # CHANGE IN PRODUCTION
  POSTGRES_DB: airflow
  
  # Hive Metastore User (created in Postgres)
  HIVE_METASTORE_USER: hive
  HIVE_METASTORE_PASSWORD: hive123  # CHANGE IN PRODUCTION
  HIVE_METASTORE_DB: metastore
  
  # Tokern Data Governance User
  TOKERN_USER: tokern
  TOKERN_PASSWORD: tokern123  # CHANGE IN PRODUCTION
  TOKERN_DB: tokern
  
  # Airflow Web UI Credentials
  AIRFLOW_USER: admin
  AIRFLOW_PASSWORD: admin123  # CHANGE IN PRODUCTION
  AIRFLOW_FERNET_KEY: "46BKJoQYlPPOexq0OhDZnIlNepKFf87WFwLbfzqDDho="  # Generate new key
  
  # Trino Credentials (if using authentication)
  TRINO_USER: trino-admin
  TRINO_PASSWORD: trino123  # CHANGE IN PRODUCTION
  
  # Jupyter Notebook Token
  JUPYTER_TOKEN: jupyter123  # CHANGE IN PRODUCTION
  
  # Marquez (OpenLineage) Credentials
  MARQUEZ_DB_USER: marquez
  MARQUEZ_DB_PASSWORD: marquez123  # CHANGE IN PRODUCTION
  MARQUEZ_DB_NAME: marquez
  
  # Service Endpoints (internal cluster DNS)
  MINIO_ENDPOINT: http://minio:9000
  MINIO_CONSOLE_URL: http://minio:9001
  POSTGRES_URL: postgres:5432
  POSTGRES_HOST: postgres
  POSTGRES_PORT: "5432"
  TRINO_URL: http://trino:8080
  AIRFLOW_URL: http://airflow:8080
  SPARK_MASTER_URL: http://spark-master:8080
  JUPYTER_URL: http://jupyter:8888
  MARQUEZ_API_URL: http://marquez-api:5000
  MARQUEZ_WEB_URL: http://marquez-web:3000
  HIVE_METASTORE_URI: thrift://hive-metastore:9083
  
  # Service Configuration
  SERVICE_NAME: enginedge-datalake
  PORT: "3010"
  
  # Logging Configuration
  LOG_LEVEL: info
  LOG_ENABLE_CONSOLE: "true"
  LOG_ENABLE_FILES: "true"
  LOG_DIR: logs

---
# Separate secret for MinIO (can be shared with other services)
apiVersion: v1
kind: Secret
metadata:
  name: minio-secret
  namespace: datalake
  labels:
    app: enginedge
    component: minio
  annotations:
    description: "MinIO credentials - can be shared across services needing S3 access"
type: Opaque
stringData:
  root-user: minioadmin
  root-password: minioadmin123  # CHANGE IN PRODUCTION
  access-key: minioadmin
  secret-key: minioadmin123  # CHANGE IN PRODUCTION

---
# Separate secret for PostgreSQL (can be shared with other services)
apiVersion: v1
kind: Secret
metadata:
  name: postgres-secret
  namespace: datalake
  labels:
    app: enginedge
    component: postgres
  annotations:
    description: "PostgreSQL credentials - can be shared across services needing DB access"
type: Opaque
stringData:
  username: airflow
  password: airflow  # CHANGE IN PRODUCTION
  database: airflow
  postgres-password: airflow  # CHANGE IN PRODUCTION
  
  # Connection strings
  connection-string: postgresql://airflow:airflow@postgres:5432/airflow
  jdbc-url: jdbc:postgresql://postgres:5432/airflow

---
# Airflow-specific secret
apiVersion: v1
kind: Secret
metadata:
  name: airflow-secret
  namespace: datalake
  labels:
    app: enginedge
    component: airflow
  annotations:
    description: "Airflow-specific credentials and configuration"
type: Opaque
stringData:
  airflow-user: admin
  airflow-password: admin123  # CHANGE IN PRODUCTION
  airflow-email: admin@enginedge.local
  fernet-key: "46BKJoQYlPPOexq0OhDZnIlNepKFf87WFwLbfzqDDho="  # GENERATE NEW KEY
  webserver-secret-key: "temporary_key_change_in_production"  # CHANGE IN PRODUCTION
  
  # Database connection for Airflow
  sql-alchemy-conn: postgresql+psycopg2://airflow:airflow@postgres:5432/airflow
  celery-result-backend: db+postgresql://airflow:airflow@postgres:5432/airflow
  celery-broker-url: redis://redis:6379/0

---
# Trino-specific secret
apiVersion: v1
kind: Secret
metadata:
  name: trino-secret
  namespace: datalake
  labels:
    app: enginedge
    component: trino
  annotations:
    description: "Trino catalog credentials and configuration"
type: Opaque
stringData:
  # Hive connector credentials
  hive-metastore-uri: thrift://hive-metastore:9083
  
  # S3/MinIO credentials for Hive connector
  s3-access-key: minioadmin
  s3-secret-key: minioadmin123  # CHANGE IN PRODUCTION
  s3-endpoint: http://minio:9000
  
  # PostgreSQL connector credentials
  postgres-connection-url: jdbc:postgresql://postgres:5432/airflow
  postgres-user: airflow
  postgres-password: airflow  # CHANGE IN PRODUCTION

---
# Hive Metastore secret
apiVersion: v1
kind: Secret
metadata:
  name: hive-metastore-secret
  namespace: datalake
  labels:
    app: enginedge
    component: hive-metastore
  annotations:
    description: "Hive Metastore database credentials"
type: Opaque
stringData:
  db-user: hive
  db-password: hive123  # CHANGE IN PRODUCTION
  db-name: metastore
  connection-url: jdbc:postgresql://postgres:5432/metastore
  
  # S3/MinIO access for Hive
  s3-access-key: minioadmin
  s3-secret-key: minioadmin123  # CHANGE IN PRODUCTION
  s3-endpoint: http://minio:9000

---
# Spark secret
apiVersion: v1
kind: Secret
metadata:
  name: spark-secret
  namespace: datalake
  labels:
    app: enginedge
    component: spark
  annotations:
    description: "Spark credentials for accessing storage and metastore"
type: Opaque
stringData:
  # S3/MinIO credentials
  aws-access-key-id: minioadmin
  aws-secret-access-key: minioadmin123  # CHANGE IN PRODUCTION
  s3-endpoint: http://minio:9000
  
  # Hive Metastore
  hive-metastore-uri: thrift://hive-metastore:9083
  
  # PostgreSQL (for Spark JDBC)
  postgres-url: jdbc:postgresql://postgres:5432/airflow
  postgres-user: airflow
  postgres-password: airflow  # CHANGE IN PRODUCTION
