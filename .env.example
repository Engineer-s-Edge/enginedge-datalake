# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123

# PostgreSQL
POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow
POSTGRES_DB=airflow

# Airflow
AIRFLOW_USER=admin
AIRFLOW_PASSWORD=admin123

# Jupyter
JUPYTER_TOKEN=jupyter123

# Datalake Observability API
PORT=3010
MINIO_ENDPOINT=http://minio:9000
MINIO_CONSOLE_URL=http://minio:9001
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
TRINO_URL=http://trino:8080
AIRFLOW_URL=http://airflow:8080
SPARK_MASTER_URL=http://spark-master:8080
JUPYTER_URL=http://jupyter:8888
POSTGRES_URL=postgres:5432
MARQUEZ_API_URL=http://marquez-api:5000
MARQUEZ_WEB_URL=http://marquez-web:3000

SERVICE_NAME=enginedge-datalake

# Logging Configuration
# Log level: error, warn, info, http, verbose, debug
LOG_LEVEL=info

# Application name (used in log file names)
APP_NAME=enginedge-datalake

# Enable/disable console logging
LOG_ENABLE_CONSOLE=true

# Enable/disable file logging
LOG_ENABLE_FILES=true

# Directory for log files (relative or absolute path)
LOG_DIR=logs

# Maximum size of each log file before rotation (e.g., 20m, 100m, 1g)
LOG_MAX_SIZE=20m

# How long to keep log files (e.g., 14d, 30d, 60d)
LOG_MAX_FILES=14d

# Optional: Sentry integration for error tracking
# SENTRY_DSN=
# SENTRY_RELEASE=
# SENTRY_TRACES_SAMPLE_RATE=0